<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="pioneer">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.177 0 0 0</pose>
        <mass>20.0</mass>
        <inertia>
          <ixx>0.3338</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.4783</iyy>
          <iyz>0.0</iyz>
          <izz>0.3338</izz>
        </inertia>
      </inertial>

      <collision name="chassis_collision">
        <pose>0 0 0.177 0 0 0</pose>
        <geometry>
          <box>
            <size>0.52 0.44 0.22</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 0.177 0 0 0</pose>
        <geometry>
          <box>
            <size>0.52 0.44 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0.75 1</ambient>
          <diffuse>1 0 0.75 1</diffuse>
        </material>
      </visual>

      <collision name="top_plate_collision">
        <pose>0.043 0 0.254 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.20 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="top_plate_visual">
        <pose>0.043 0 0.254 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.22 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0.9 0.1 1</ambient>
          <diffuse>1 0.9 0.1 1</diffuse>
        </material>
      </visual>

      <visual name="mast_visual">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
        </material>
      </visual>
      <visual name="flag_visual">
        <pose>0 0.06 0.82 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.12 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 1 1</ambient>
          <diffuse>1 0 1 1</diffuse>
        </material>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>imu</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.05</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <link name="laser_frame">
      <pose>0.2 0 0.281 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.04 0.04 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>
      <sensor name="front_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>810</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>20.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent>base_link</parent>
      <child>laser_frame</child>
    </joint>

    <link name="cam_frame">
      <pose>0.24 0 0.261 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-4</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-4</iyy>
          <iyz>0</iyz>
          <izz>1e-4</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.06 0.05 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.07 0.05 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.25 0.9 1</ambient>
          <diffuse>0.1 0.25 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="cam_joint" type="fixed">
      <parent>base_link</parent>
      <child>cam_frame</child>
    </joint>

    <link name="cam_optical_link">
      <pose>0.24 0 0.261 -1.5708 0 -1.5708</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>2</update_rate>
        <topic>camera/image</topic>
        <gz_frame_id>cam_optical_link</gz_frame_id>
        <camera>
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.204277</horizontal_fov>
          <image>
            <width>160</width>
            <height>120</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>12.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0075</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <joint name="cam_optical_joint" type="fixed">
      <parent>cam_frame</parent>
      <child>cam_optical_link</child>
    </joint>

    <link name="p3at_front_left_wheel">
      <pose>0.135 0.197 0.111 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.012411765597</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.015218160428</iyy>
          <iyz>0</iyz>
          <izz>0.011763977943</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 -1.57079635 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.111</radius>
            <length>0.075</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 -1.57079635 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.111</radius>
            <length>0.075</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.117 0.117 0.117 1</ambient>
          <diffuse>0.117 0.117 0.117 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="p3at_front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>p3at_front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <damping>0.7</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="p3at_front_right_wheel">
