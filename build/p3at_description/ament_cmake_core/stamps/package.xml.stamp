<?xml version="1.0"?>
<package format="3">
  <name>p3at_description</name>
  <version>0.1.0</version>
  <description>Pioneer 3-AT robot description, meshes, xacro, and RViz resources for AUTO4508 Part 1.</description>

  <maintainer email="god@example.com">god</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
